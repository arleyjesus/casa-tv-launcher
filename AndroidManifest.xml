<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="tv.casa.launcher" android:versionCode="10" android:versionName="0.10.0">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
  <uses-feature android:name="android.software.leanback" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <queries>
    <provider android:authorities="com.tcl.settings.slice" />
    <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
    <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
  </queries>
  <application android:label="@string/app_name" android:theme="@style/AppTheme" android:icon="@drawable/banner" android:banner="@drawable/banner" android:usesCleartextTraffic="false" android:allowBackup="false" android:supportsRtl="true">
    <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTask" android:excludeFromRecents="true">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
    </activity>
    <activity android:name=".GameModeActivity" android:exported="false" android:screenOrientation="landscape" />
    <activity android:name=".GameBrowserActivity" android:exported="false" android:screenOrientation="landscape" />
    <activity android:name=".PictureControlsActivity" android:exported="false" android:screenOrientation="landscape" />
    <activity android:name=".OnlineAmbientActivity" android:exported="false" android:screenOrientation="landscape" />
    <activity android:name=".GalleryActivity" android:exported="false" android:screenOrientation="landscape" />
    <activity android:name=".AmbientActivity" android:exported="false" android:screenOrientation="landscape" />
    <receiver android:name=".BackupReceiver" android:exported="true" android:permission="android.permission.DUMP">
      <intent-filter><action android:name="tv.casa.launcher.EXPORT_CONFIGURATION" /></intent-filter>
    </receiver>
    <service android:name=".HomeService" android:exported="true" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="Casa Aura · Botón Inicio">
      <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
      <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility" />
    </service>
    <service android:name=".CasaDream" android:exported="true" android:permission="android.permission.BIND_DREAM_SERVICE" android:label="Casa Aura · Ambiente">
      <intent-filter><action android:name="android.service.dreams.DreamService" /></intent-filter>
      <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
    </service>
  </application>
</manifest>
